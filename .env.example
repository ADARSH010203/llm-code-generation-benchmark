# Copy this file to .env.local (or .env) and add real values locally.
# Never commit credentials.
CEREBRAS_API_KEY=
COHERE_API_KEY=

# Used by DeepEval GEval / ArenaGEval.
OPENAI_API_KEY=
DEEPEVAL_MODEL=gpt-5.4

# Optional generation safeguards.
MAX_CONTEXT_CHARS=100000
MAX_OUTPUT_TOKENS=6000
LLM_REQUEST_TIMEOUT=90
LLM_RETRIES=2
